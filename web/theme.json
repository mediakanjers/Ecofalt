{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": false,
    "color": {
      "custom": false,
      "customGradient": false,
      "customDuotone": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "gradients": [],
      "duotone": [],
      "palette": [
        { "name": "Groen (primair)", "slug": "primary", "color": "#2EA836" },
        { "name": "Middengroen", "slug": "green", "color": "#307F32" },
        { "name": "Donkergroen", "slug": "dark-green", "color": "#164822" },
        { "name": "Lichtgrijs", "slug": "light-grey", "color": "#D6D6D6" },
        { "name": "Grijs", "slug": "grey", "color": "#58585A" },
        { "name": "Gebroken wit", "slug": "off-white", "color": "#F1EFEE" },
        { "name": "Antraciet", "slug": "anthracite", "color": "#434A55" },
        { "name": "Zwart", "slug": "black", "color": "#000000" },
        { "name": "Wit", "slug": "white", "color": "#FFFFFF" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": false,
      "fontStyle": false,
      "fontWeight": false,
      "letterSpacing": false,
      "lineHeight": false,
      "textDecoration": false,
      "textTransform": false,
      "writingMode": false,
      "fontFamilies": [
        {
          "name": "Space Grotesk (titels)",
          "slug": "heading",
          "fontFamily": "'Space Grotesk', 'Helvetica Neue', Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Space Grotesk",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/spacegrotesk-normal-latin-ext.woff2"],
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
            },
            {
              "fontFamily": "Space Grotesk",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/spacegrotesk-normal-latin.woff2"],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "name": "Rubik (tekst)",
          "slug": "body",
          "fontFamily": "'Rubik', 'Helvetica Neue', Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Rubik",
              "fontStyle": "normal",
              "fontWeight": "300 900",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/rubik-normal-latin-ext.woff2"],
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
            },
            {
              "fontFamily": "Rubik",
              "fontStyle": "normal",
              "fontWeight": "300 900",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/rubik-normal-latin.woff2"],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Rubik",
              "fontStyle": "italic",
              "fontWeight": "300 900",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/rubik-italic-latin-ext.woff2"],
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
            },
            {
              "fontFamily": "Rubik",
              "fontStyle": "italic",
              "fontWeight": "300 900",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/rubik-italic-latin.woff2"],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "name": "Klein",
          "slug": "small",
          "size": "0.875rem",
          "lineHeight": "1.5",
          "fontWeight": 400,
          "fontColor": "#000000"
        },
        {
          "name": "Leestekst",
          "slug": "normal",
          "size": "1rem",
          "lineHeight": "1.5",
          "fontWeight": 400,
          "fontColor": "#000000"
        },
        {
          "name": "Introtekst",
          "slug": "intro",
          "size": "clamp(1.0625rem, 1.0405rem + 0.0939vw, 1.125rem)",
          "lineHeight": "1.6",
          "fontWeight": 400,
          "fontColor": "#000000"
        },
        {
          "name": "H4",
          "slug": "h4",
          "size": "clamp(1.1875rem, 1.1215rem + 0.2817vw, 1.375rem)",
          "lineHeight": "1.3",
          "fontWeight": 700
        },
        {
          "name": "H3",
          "slug": "h3",
          "size": "clamp(1.375rem, 1.243rem + 0.5634vw, 1.75rem)",
          "lineHeight": "1.25",
          "fontWeight": 700
        },
        {
          "name": "H2",
          "slug": "h2",
          "size": "clamp(1.6875rem, 1.4894rem + 0.8451vw, 2.25rem)",
          "lineHeight": "1.2",
          "fontWeight": 700
        },
        {
          "name": "H1",
          "slug": "h1",
          "size": "clamp(2rem, 1.6479rem + 1.5023vw, 3rem)",
          "lineHeight": "1.15",
          "fontWeight": 700
        }
      ]
    },
    "spacing": {
      "blockGap": false,
      "margin": false,
      "padding": false,
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "units": ["px", "em", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        { "name": "XS", "slug": "xs", "size": "clamp(0.5rem, 0.456rem + 0.1878vw, 0.625rem)" },
        { "name": "S", "slug": "s", "size": "clamp(0.75rem, 0.662rem + 0.3756vw, 1rem)" },
        { "name": "M", "slug": "m", "size": "clamp(1rem, 0.8239rem + 0.7512vw, 1.5rem)" },
        { "name": "L", "slug": "l", "size": "clamp(1.5rem, 1.1479rem + 1.5023vw, 2.5rem)" },
        { "name": "XL", "slug": "xl", "size": "clamp(2.5rem, 1.9718rem + 2.2535vw, 4rem)" },
        { "name": "Sectie", "slug": "section", "size": "clamp(3.5rem, 2.5317rem + 4.1315vw, 6.25rem)" }
      ]
    },
    "layout": {
      "contentSize": "1400px",
      "wideSize": "1700px"
    },
    "custom": {
      "gutter": "clamp(1.25rem, 0.8099rem + 1.8779vw, 2.5rem)",
      "radius": "10px",
      "radiusImage": "13px",
      "transition": "0.25s ease",
      "shadow": {
        "header": "0 2px 12px rgba(0, 0, 0, 0.08)",
        "button-hover": "0 8px 20px rgba(46, 168, 54, 0.35)"
      },
      "color": {
        "placeholder": "#707070",
        "error": "#D63638"
      },
      "breakpoint": {
        "sm": "600px",
        "md": "900px",
        "lg": "1200px",
        "xl": "1440px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|white",
      "text": "var:preset|color|black"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|normal",
      "fontWeight": "400",
      "lineHeight": "1.5"
    },
    "elements": {
      "heading": {
        "color": { "text": "var:preset|color|black" },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "700"
        }
      },
      "h1": {
        "typography": { "fontSize": "var:preset|font-size|h1", "fontWeight": "700", "lineHeight": "1.15" }
      },
      "h2": {
        "typography": { "fontSize": "var:preset|font-size|h2", "fontWeight": "700", "lineHeight": "1.2" }
      },
      "h3": {
        "typography": { "fontSize": "var:preset|font-size|h3", "fontWeight": "700", "lineHeight": "1.25" }
      },
      "h4": {
        "typography": { "fontSize": "var:preset|font-size|h4", "fontWeight": "700", "lineHeight": "1.3" }
      },
      "h5": {
        "typography": { "fontSize": "1.125rem", "fontWeight": "700", "lineHeight": "1.4" }
      },
      "h6": {
        "typography": { "fontSize": "1rem", "fontWeight": "700", "lineHeight": "1.5" }
      },
      "link": {
        "color": { "text": "var:preset|color|primary" },
        "typography": { "textDecoration": "none" }
      },
      "button": {
        "border": { "radius": "10px" },
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|white"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "1rem",
          "fontWeight": "400",
          "lineHeight": "1.5"
        }
      }
    }
  }
}
